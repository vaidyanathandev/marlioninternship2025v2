# Firebase Configuration
# Get these from Firebase Console: https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Convex Configuration
# Get this from Convex Dashboard: https://dashboard.convex.dev/
VITE_CONVEX_URL=

# AI Configuration
# Note: "DigitalOcean AI" doesn't exist as of Jan 2025. Configure with your AI provider:
# - For OpenAI: https://api.openai.com/v1
# - For Anthropic Claude: https://api.anthropic.com/v1
# - For local Ollama: http://localhost:11434/v1
# - Or any OpenAI-compatible endpoint
VITE_AI_API_KEY=
VITE_AI_ENDPOINT=https://api.openai.com/v1
VITE_AI_MODEL=gpt-4-turbo-preview

# Email Service (for sending OTP and notifications)
# You'll need to set up a service like SendGrid, Mailgun, or AWS SES
VITE_EMAIL_SERVICE_API_KEY=

# SMS Service (for phone OTP)
# Firebase handles this, but you may need additional configuration
# https://firebase.google.com/docs/auth/web/phone-auth

# File Storage
# Firebase Storage is configured via Firebase settings above
# Alternatively, use Cloudinary, AWS S3, etc.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Application Configuration
# These are optional - defaults are set in packages/config
VITE_APP_NAME="Marlion Internship Platform"
VITE_REGISTRATION_DEADLINE="2025-11-30"
VITE_INTERNSHIP_START_DATE="2025-12-02"
